import os
import json
import pandas as pd

folder_path = r"C:\Users\dell\OneDrive\Desktop\New Folder\Projects using DS\ipl_json"


# ============================================================
# TEAM NAME NORMALIZATION
# ============================================================

team_name_mapping = {
    'Royal Challengers Bangalore': 'Royal Challengers Bengaluru',
    'Kings XI Punjab': 'Punjab Kings',
    'Delhi Daredevils': 'Delhi Capitals',
    'Rising Pune Supergiants': 'Rising Pune Supergiant'
}


def normalize_team(team):
    return team_name_mapping.get(team, team)


# ============================================================
# LOAD MATCH DATA
# ============================================================

matches = pd.read_csv(
    os.path.join(folder_path, "ipl_final.csv")
)

matches['match_id'] = matches['match_id'].astype(str)
matches['date'] = pd.to_datetime(matches['date'])

if 'season' not in matches.columns:
    matches['season'] = matches['date'].dt.year


for col in ['team1', 'team2', 'toss_winner', 'winner']:
    if col in matches.columns:
        matches[col] = matches[col].replace(team_name_mapping)


print("✅ Match data loaded")


# ============================================================
# 1. SEASON-WISE TEAM PLAYERS
# ============================================================

season_player_records = []


for file in os.listdir(folder_path):

    if not file.endswith(".json"):
        continue

    file_path = os.path.join(folder_path, file)

    with open(file_path, "r") as f:
        data = json.load(f)

    info = data.get("info", {})

    dates = info.get("dates", [])

    if not dates:
        continue

    season = pd.to_datetime(dates[0]).year

    players_data = info.get("players", {})

    for team, players in players_data.items():

        team = normalize_team(team)

        for player in players:

            season_player_records.append({
                "season": season,
                "team": team,
                "player": player
            })


season_players = pd.DataFrame(
    season_player_records
).drop_duplicates()


season_players = season_players.sort_values(
    ['season', 'team', 'player']
).reset_index(drop=True)


season_players.to_csv(
    os.path.join(
        folder_path,
        "season_team_players.csv"
    ),
    index=False
)


print(
    "✅ Season-wise player database created:",
    len(season_players)
)


# ============================================================
# 2. PLAYER OF THE MATCH DATA
# ============================================================

potm_columns = [
    'match_id',
    'season',
    'date',
    'team1',
    'team2',
    'venue',
    'winner',
    'player_of_match'
]


potm_matches = matches[
    [
        col
        for col in potm_columns
        if col in matches.columns
    ]
].copy()


potm_matches.to_csv(
    os.path.join(
        folder_path,
        "player_of_match.csv"
    ),
    index=False
)


# ============================================================
# POTM TOTAL AWARDS
# ============================================================

valid_potm = potm_matches[
    potm_matches['player_of_match'].notna()
].copy()


valid_potm = valid_potm[
    valid_potm['player_of_match'] != 'Unknown'
]


potm_summary = (
    valid_potm
    .groupby('player_of_match')
    .size()
    .reset_index(name='potm_awards')
    .sort_values(
        'potm_awards',
        ascending=False
    )
    .reset_index(drop=True)
)


potm_summary.to_csv(
    os.path.join(
        folder_path,
        "potm_summary.csv"
    ),
    index=False
)


print(
    "✅ Player of the Match database created"
)


# ============================================================
# 3. LOAD BALL DATA FOR ORANGE / PURPLE CAP
# ============================================================

balls = pd.read_csv(
    os.path.join(
        folder_path,
        "ipl_balls.csv"
    )
)


balls['match_id'] = balls['match_id'].astype(str)


# ============================================================
# ADD SEASON TO BALL DATA
# ============================================================

season_map = matches[
    ['match_id', 'season']
].drop_duplicates()


balls = balls.merge(
    season_map,
    on='match_id',
    how='left'
)


print("✅ Season added to ball-by-ball data")


# ============================================================
# 4. ORANGE CAP — MOST RUNS EACH SEASON
# ============================================================

season_batting = (
    balls
    .groupby(
        ['season', 'batter']
    )['runs_batter']
    .sum()
    .reset_index(
        name='runs'
    )
)


season_batting['rank'] = (
    season_batting
    .groupby('season')['runs']
    .rank(
        method='min',
        ascending=False
    )
)


orange_cap = (
    season_batting[
        season_batting['rank'] == 1
    ]
    .drop(columns='rank')
    .sort_values('season')
    .reset_index(drop=True)
)


orange_cap.to_csv(
    os.path.join(
        folder_path,
        "orange_cap.csv"
    ),
    index=False
)


print("✅ Orange Cap data created")


# ============================================================
# 5. PURPLE CAP — MOST WICKETS EACH SEASON
# ============================================================

bowler_wicket_types = [
    'bowled',
    'caught',
    'caught and bowled',
    'hit wicket',
    'lbw',
    'stumped'
]


# Agar bowler_wicket column saved nahi hai
if 'bowler_wicket' not in balls.columns:

    if 'dismissal_kind' in balls.columns:

        balls['bowler_wicket'] = (
            balls['dismissal_kind']
            .isin(bowler_wicket_types)
            .astype(int)
        )

    else:

        raise ValueError(
            "dismissal_kind column missing from ipl_balls.csv"
        )


season_bowling = (
    balls
    .groupby(
        ['season', 'bowler']
    )['bowler_wicket']
    .sum()
    .reset_index(
        name='wickets'
    )
)


season_bowling['rank'] = (
    season_bowling
    .groupby('season')['wickets']
    .rank(
        method='min',
        ascending=False
    )
)


purple_cap = (
    season_bowling[
        season_bowling['rank'] == 1
    ]
    .drop(columns='rank')
    .sort_values('season')
    .reset_index(drop=True)
)


purple_cap.to_csv(
    os.path.join(
        folder_path,
        "purple_cap.csv"
    ),
    index=False
)


print("✅ Purple Cap data created")


# ============================================================
# 6. IPL CHAMPIONS / FINAL WINNERS
# ============================================================

final_records = []


for file in os.listdir(folder_path):

    if not file.endswith(".json"):
        continue

    file_path = os.path.join(
        folder_path,
        file
    )

    with open(
        file_path,
        "r"
    ) as f:

        data = json.load(f)


    info = data.get(
        "info",
        {}
    )


    dates = info.get(
        "dates",
        []
    )


    if not dates:
        continue


    season = pd.to_datetime(
        dates[0]
    ).year


    event = info.get(
        "event",
        {}
    )


    stage = str(
        event.get(
            "stage",
            ""
        )
    ).strip()


    # Exact IPL Final
    if stage.lower() == "final":

        winner = (
            info
            .get(
                "outcome",
                {}
            )
            .get(
                "winner"
            )
        )


        if winner:

            winner = normalize_team(
                winner
            )


            final_records.append({
                "season": season,
                "champion": winner,
                "match_id": file.replace(
                    ".json",
                    ""
                )
            })


champions = pd.DataFrame(
    final_records
)


# ============================================================
# FALLBACK IF FINAL STAGE MISSING
# ============================================================

found_seasons = (
    set(champions['season'])
    if len(champions) > 0
    else set()
)


all_seasons = set(
    matches['season'].unique()
)


missing_final_seasons = (
    all_seasons
    - found_seasons
)


fallback_records = []


for season in missing_final_seasons:

    season_matches = (
        matches[
            matches['season'] == season
        ]
        .sort_values('date')
    )


    if len(season_matches) == 0:
        continue


    last_match = (
        season_matches.iloc[-1]
    )


    winner = last_match['winner']


    if (
        pd.notna(winner)
        and winner != 'No Result'
    ):

        fallback_records.append({
            "season": season,
            "champion": winner,
            "match_id": str(
                last_match['match_id']
            )
        })


if fallback_records:

    fallback_df = pd.DataFrame(
        fallback_records
    )

    champions = pd.concat(
        [
            champions,
            fallback_df
        ],
        ignore_index=True
    )


champions = (
    champions
    .drop_duplicates(
        subset='season'
    )
    .sort_values('season')
    .reset_index(drop=True)
)


champions.to_csv(
    os.path.join(
        folder_path,
        "ipl_champions.csv"
    ),
    index=False
)


print("✅ IPL Champions data created")


# ============================================================
# 7. TOTAL IPL TITLES PER TEAM
# ============================================================

title_counts = (
    champions
    .groupby('champion')
    .size()
    .reset_index(
        name='titles'
    )
    .sort_values(
        'titles',
        ascending=False
    )
    .reset_index(drop=True)
)


title_counts.to_csv(
    os.path.join(
        folder_path,
        "team_title_counts.csv"
    ),
    index=False
)


print("✅ Team title counts created")


# ============================================================
# 8. SEASON SUMMARY
# ============================================================

orange_summary = (
    orange_cap
    .groupby('season')
    .agg({
        'batter':
            lambda x: ', '.join(
                x.astype(str)
            ),

        'runs':
            'max'
    })
    .reset_index()
    .rename(columns={
        'batter': 'orange_cap',
        'runs': 'orange_cap_runs'
    })
)


purple_summary = (
    purple_cap
    .groupby('season')
    .agg({
        'bowler':
            lambda x: ', '.join(
                x.astype(str)
            ),

        'wickets':
            'max'
    })
    .reset_index()
    .rename(columns={
        'bowler': 'purple_cap',
        'wickets': 'purple_cap_wickets'
    })
)


season_summary = champions[
    [
        'season',
        'champion'
    ]
].copy()


season_summary = season_summary.merge(
    orange_summary,
    on='season',
    how='left'
)


season_summary = season_summary.merge(
    purple_summary,
    on='season',
    how='left'
)


season_summary.to_csv(
    os.path.join(
        folder_path,
        "season_summary.csv"
    ),
    index=False
)


# ============================================================
# FINAL OUTPUT
# ============================================================

print("\n")
print("=" * 60)
print("🔥 IPL ADVANCED DATABASE COMPLETE")
print("=" * 60)


print("\n🏆 IPL Champions:")
print(
    champions.to_string(
        index=False
    )
